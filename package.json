{
  "name": "m33e-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run theme && vitepress dev",
    "build": "pnpm run theme && vitepress build",
    "preview": "vitepress preview",
    "verify": "node scripts/verify.mjs",
    "theme": "tsx scripts/generate-theme.mjs",
    "format": "prettier --write \"docs/**/*.{md,vue,css,ts}\" \".vitepress/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@binarynoir/vitepress-blog": "0.7.1",
    "@fontsource-variable/google-sans-flex": "5.3.2",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "material-symbols": "0.48.2",
    "verve-tokens": "0.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "markdown-it": "15.0.3",
    "markdown-it-github-alerts": "1.0.1",
    "markdown-it-mathjax3": "4.3.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitepress": "2.0.0-alpha.21"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
